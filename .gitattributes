# Сборки игр в games/ — это готовые бинарники движка. Git не должен
# нормализовать в них переводы строк, иначе wasm/pck ломаются на checkout.
games/**/*.wasm  binary
games/**/*.pck   binary
games/**/*.png   binary
games/**/*.glb   binary
games/**/*.ico   binary

# Установщики расширения в apps/ — это zip-контейнеры. Git обычно и сам
# опознаёт их как бинарные, но правило задано явно: если однажды он решит,
# что это текст, и переведёт переводы строк, .zip и .xpi станут битыми.
apps/**/*.zip  binary
apps/**/*.xpi  binary

# Клипы карточек в assets/media/ — готовые mp4/webm. Git и сам обычно опознаёт
# их как бинарные, но правило задано явно: если однажды он решит, что это текст,
# и переведёт переводы строк, файл перестанет открываться в браузере.
assets/media/**  binary
